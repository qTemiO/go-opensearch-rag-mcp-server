# Copy to .env (or .env.production) and adjust.
HOST=0.0.0.0
PORT=13005
MCP_PATH=/mcp
STATELESS_HTTP=true
JSON_RESPONSE=true

GO_OPENSEARCH_DATABASE_URL=http://go-opensearch-database:8000
REQUEST_TIMEOUT_SECONDS=60

# IANA zone for current_time, e.g. Europe/Moscow; empty = container local time
TIMEZONE=
LOG_LEVEL=INFO
